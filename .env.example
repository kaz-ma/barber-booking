# Copy to .env.local for local development (`npm run db:start` creates a minimal one).
# Only DATABASE_URL is required locally; every secret below is required on Vercel
# production / preview (validated in src/lib/env.ts). Never commit real values.

# Absolute origin, no trailing slash (FR-S-10). Local: http://localhost:3000
SITE_URL=http://localhost:3000

# App connection. Local cluster from scripts/db-local.sh, or Neon's pooled URL (-pooler, sslmode=require)
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/barber_dev
# Direct endpoint for migrations / pg_dump (Neon). Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Used by `npm test` (scripts/test.sh fills it from the local cluster when unset)
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:54329/barber_test

# Better Auth (admin slice). 32+ random bytes: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The single admin (FR-A-01). `npm run db:seed-admin` creates the auth_user row from it.
ADMIN_EMAIL=
# Admin login code delivery (emailOTP). Unset locally: the 6-digit code is printed to the dev
# server log with a warning (development only; never in production).
RESEND_API_KEY=
RESEND_FROM=

# Web Push (push slice). Generate once and NEVER rotate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# Vercel Cron bearer token (32+ bytes)
CRON_SECRET=

# Cloudflare Turnstile. When TURNSTILE_SECRET_KEY is empty locally, siteverify is skipped (logged).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# HMAC key for IP / phone hashes in rate_limits and audit_log (32+ bytes). Dev fallback if empty.
PII_HASH_SECRET=

# Monitoring (later slice)
SENTRY_DSN=
SENTRY_CSP_REPORT_URI=

# Set to 1 to skip env validation (e.g. `next typegen` in tooling)
SKIP_ENV_VALIDATION=
