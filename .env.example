# Copy to .env.local for local development (`npm run db:start` creates a minimal one).
# Only DATABASE_URL is required locally. Every secret below is REQUIRED whenever the app runs in
# production mode (NODE_ENV=production: Vercel, Cloudflare, `next start`, Docker — any platform)
# and on Vercel preview; the server refuses to start without them (src/lib/env.ts, SR-05).
# Locally, a missing BETTER_AUTH_SECRET / PII_HASH_SECRET is replaced by a random per-process
# value with a warning, and Turnstile is skipped. Never commit real values.

# Absolute origin, no trailing slash (FR-S-10). Local: http://localhost:3000
SITE_URL=http://localhost:3000

# App connection. Local cluster from scripts/db-local.sh, or Neon's pooled URL (-pooler, sslmode=require)
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/barber_dev
# Direct endpoint for migrations / pg_dump (Neon). Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Used by `npm test` (scripts/test.sh fills it from the local cluster when unset)
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:54329/barber_test

# Better Auth (admin slice). 32+ random bytes: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The single admin (FR-A-01). `npm run db:seed-admin` creates the auth_user row from it (stored
# lower-case). Required in production together with RESEND_API_KEY / RESEND_FROM.
ADMIN_EMAIL=
# Admin login code delivery (emailOTP). Unset locally: the 6-digit code is printed to the dev
# server log with a warning (development only; required in production).
RESEND_API_KEY=
RESEND_FROM=

# Web Push (push slice). Generate once and NEVER rotate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# Vercel Cron bearer token (32+ bytes)
CRON_SECRET=

# Cloudflare Turnstile. When TURNSTILE_SECRET_KEY is empty in development / test, siteverify is
# skipped (logged); in production it fails closed.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Test only: alternative siteverify endpoint (the E2E run uses a local stub). Never set in production.
TURNSTILE_VERIFY_URL=

# HMAC key for IP / phone hashes in rate_limits, consents and audit_log (32+ bytes). Never rotate.
PII_HASH_SECRET=

# Monitoring (later slice). CSP reports go to /api/csp-report unless SENTRY_CSP_REPORT_URI is set.
SENTRY_DSN=
SENTRY_CSP_REPORT_URI=
# 1 = enforce the public CSP (after a clean Report-Only week, AT-26); empty = Report-Only
CSP_ENFORCE=

# Set to 1 to skip env validation (e.g. `next typegen` in tooling). Ignored in production.
SKIP_ENV_VALIDATION=
